{
  "trailingSlash": "auto",
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": [
      "/brand/*",
      "/_next/*",
      "/sso/*",
      "*.{css,js,ico,png,jpg,jpeg,gif,svg,webp,woff,woff2,txt,json}"
    ]
  },
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff",
    "Referrer-Policy": "strict-origin-when-cross-origin"
  }
}
