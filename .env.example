# POS Lite Web environment configuration
# Copy this file to .env.local for local development.
#
# Do not put real credentials, shop passwords, or personal tokens in this file.
# The API URL must be supplied through NEXT_PUBLIC_API_BASE_URL only.
# Do not hardcode the API URL in application source.

NEXT_PUBLIC_API_BASE_URL=https://your-api-host.example.com

# Application environment: development | staging | production
NEXT_PUBLIC_APP_ENV=development

# After logout, send the browser to Auralizz home. Leave empty to stay on /login.
# Production GitHub Actions uses:
# NEXT_PUBLIC_API_BASE_URL=https://auralizzposliteapiproduction-hbgbcvfkhuc7hwaz.southindia-01.azurewebsites.net
# NEXT_PUBLIC_APP_ENV=production
# NEXT_PUBLIC_AURALIZZ_HOME_URL=https://auralizz.com/home
NEXT_PUBLIC_AURALIZZ_HOME_URL=
